PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SESSION_STATE_MODE=sticky

OIDC_ISSUER=https://issuer.example.com/
OIDC_AUDIENCE=https://identity-control-plane.example
OIDC_JWKS_URI=https://issuer.example.com/.well-known/jwks.json

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=verify-full
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PGSSL=require
PGSSL_REJECT_UNAUTHORIZED=true

UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=50
